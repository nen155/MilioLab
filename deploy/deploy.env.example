# Credenciales y rutas del hosting compartido (IONOS) para MilioLab.
# Copia este archivo a `deploy/deploy.env` y rellénalo. Está en .gitignore:
# NUNCA se sube al repositorio.

# --- Acceso SFTP -------------------------------------------------------------
# En el panel de IONOS: Hosting → SFTP & SSH.
DEPLOY_PROTOCOL=sftp
DEPLOY_HOST=
DEPLOY_PORT=22
DEPLOY_USER=
DEPLOY_PASSWORD=

# --- Rutas remotas -----------------------------------------------------------
# Docroot de miliolab.com (donde se sube la web pública).
DEPLOY_WEB_DIR=/htdocs/miliolab
# Panel: subcarpeta del dominio.
DEPLOY_PANEL_DIR=/htdocs/miliolab/milio
# API: los archivos públicos (index.php, .htaccess, media/) van en /api.
DEPLOY_API_PUBLIC_DIR=/htdocs/miliolab/api
# Aplicación Laravel completa, FUERA del docroot.
DEPLOY_API_APP_DIR=/htdocs/miliolab-api

# --- URLs públicas -----------------------------------------------------------
DEPLOY_SITE_URL=https://miliolab.com
DEPLOY_API_URL=https://miliolab.com/api

# --- Token de los scripts de despliegue --------------------------------------
# Cadena larga y aleatoria: protege unzip-deploy.php y deploy.php.
DEPLOY_TOKEN=
